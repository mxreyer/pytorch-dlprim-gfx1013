+    // --- BC-250 investigation: runtime conv algorithm override ---------------
+    // The "auto" heuristics below are static: any 3x3/pad-1/stride-1 conv with
+    // >=8 channels gets Winograd, with no cost model and no per-device tuning.
+    // These env vars let the choice be measured instead of assumed.
+    //   DLPRIM_CONV_ALGO             - applies to all three directions
+    //   DLPRIM_CONV_FWD_ALGO         - forward only
+    //   DLPRIM_CONV_BWD_DATA_ALGO    - backward-data only
+    //   DLPRIM_CONV_BWD_FILTER_ALGO  - backward-filter only
+    // Values: auto | winograd | gemm | depthwise_separable
+    // An explicit algo passed by the caller always wins over the env var.
+    static std::string conv_algo_env(std::string const &algo,char const *var)
+    {
+        if(!(algo == "auto" || algo.empty()))
+            return algo;
+        char const *e = getenv(var);
+        if(!e)
+            e = getenv("DLPRIM_CONV_ALGO");
+        if(e && *e)
+            return e;
+        return algo;
+    }
+

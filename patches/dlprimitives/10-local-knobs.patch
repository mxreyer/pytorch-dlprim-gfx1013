+            }
+            else {
+                // aim for >= 4 work-groups per CU so the tail is cheap. More
+                // splitting does not help (measured 2026-09-10: targets of 8,
+                // 16 and 32 per CU, caps to 64, all within noise of this), the
+                // kernel is not short of work-groups. Overridable for
+                // measurement: DLPRIM_WINOGRAD_KSPLIT_TARGET (per CU, default 4),
+                // DLPRIM_WINOGRAD_KSPLIT_MAX (cap, default 16).
+                // With the fp16 inner loop, shorter K slices halve the
+                // accumulation error (dW 1.1% -> 0.5%) at no measured cost.
+                int per_cu = conv_fp16() ? 16 : 4, cap = conv_fp16() ? 64 : 16;

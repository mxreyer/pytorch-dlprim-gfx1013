+            // --- BC-250 investigation -------------------------------------
+            // Stock rule: split the K (batch*tiles) reduction 8 ways only when
+            // (C/32)*(N/32)*256 < estimated_core_count(). On a 40 CU AMD part
+            // that is 2560 work items = 10 work-groups, so any conv with >=10
+            // work-groups runs unsplit -- including 128->128, which launches
+            // exactly 16 work-groups onto 40 CUs and leaves 24 idle.
+            // Pick the split from how many work-groups the launch actually has
+            // versus how many CUs there are to fill.
             int wg_count = ((config_.channels_in + 31) / 32)

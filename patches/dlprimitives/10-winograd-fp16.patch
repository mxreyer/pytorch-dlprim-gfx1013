+    // 19.4 -> 12.4 per ResNet-9 step; Y/dX within ~0.5% of fp32, dW ~0.5%
+    // with the shorter K slices below. Off by default: fp32 callers get fp32.
+    static bool conv_fp16()
+    {
+        char const *e = getenv("DLPRIM_CONV_FP16");
+        return e && *e && atoi(e) != 0;
+    }
+
     // TR_STRIDE_OFFSET pads the transpose-stage scratch to keep rows off the
     // same LDS bank, but any non-zero offset also turns on PADDING_FACTOR in
     // the kernel, which allocates 16 more tile rows: 40 KiB per work-group
@@ -245,7 +259,7 @@ namespace core {

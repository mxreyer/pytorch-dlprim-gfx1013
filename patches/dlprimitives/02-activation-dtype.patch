From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mxreyer <236478497+mxreyer@users.noreply.github.com>
Subject: [PATCH] activation: build the kernel with the tensor's dtype

activation_forward/backward built activation.cl with only the ACTIVATION
define. The kernel is written in terms of dtype, which defs.h defaults to
float, so a half tensor was read and written as float bytes and relu, tanh,
sigmoid and relu6 on half returned garbage without an error.

Pass dtype through get_program as the other kernels do, check that input
and output dtypes match, and take activation_diff's beta as float (the host
passes a float whatever the tensor dtype) and cast it inside the kernel.
---
 src/core/activation.cpp   | 11 +++++++++--
 src/kernels/activation.cl |  3 ++-
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/src/core/activation.cpp b/src/core/activation.cpp
index 3d6045d..fbf2798 100644
--- a/src/core/activation.cpp
+++ b/src/core/activation.cpp
@@ -13,8 +13,13 @@ namespace core {
     void activation_forward(Tensor &x,Tensor &y,StandardActivations activation, ExecutionContext const &ec)
     {
         Context ctx(ec);
+        // The kernel is templated on dtype through this define; without it a
+        // half tensor was processed as float bytes (relu on half returned
+        // garbage).
+        DLPRIM_CHECK(x.dtype() == y.dtype());
         cl::Program const &prog = gpu::Cache::instance().get_program(ctx,"activation",
-                                                    "ACTIVATION",int(activation));
+                                                    "ACTIVATION",int(activation),
+                                                    "dtype",data_type_to_opencl_type(x.dtype()));
         cl::Kernel k(prog,"activation");
 
         int p=0;
@@ -30,8 +35,10 @@ namespace core {
     void activation_backward(Tensor &dx,Tensor &dy,Tensor &y,StandardActivations activation,float beta,ExecutionContext const &ec)
     {
         Context ctx(ec);
+        DLPRIM_CHECK(y.dtype() == dy.dtype() && y.dtype() == dx.dtype());
         cl::Program const &prog = gpu::Cache::instance().get_program(ctx,"activation",
-                                                    "ACTIVATION",int(activation));
+                                                    "ACTIVATION",int(activation),
+                                                    "dtype",data_type_to_opencl_type(y.dtype()));
         cl::Kernel k(prog,"activation_diff");
         
         
diff --git a/src/kernels/activation.cl b/src/kernels/activation.cl
index 2327e24..968b137 100644
--- a/src/kernels/activation.cl
+++ b/src/kernels/activation.cl
@@ -20,7 +20,7 @@ void activation(ulong size,__global dtype *a,ulong a_offset, __global dtype *c,u
 
 
 __kernel
-void activation_diff(ulong size,__global dtype *y,ulong y_offset, __global dtype *dy,ulong dy_offset,__global dtype *dx,ulong dx_offset,dtype beta)
+void activation_diff(ulong size,__global dtype *y,ulong y_offset, __global dtype *dy,ulong dy_offset,__global dtype *dx,ulong dx_offset,float beta_f)
 {
     ulong pos = get_global_id(0);
     if(pos >= size)
@@ -30,6 +30,7 @@ void activation_diff(ulong size,__global dtype *y,ulong y_offset, __global dtype
     dx+=dx_offset;
     dtype y_val  = y[pos];
     dtype dy_val = dy[pos];
+    dtype beta = (dtype)beta_f;   // scalar kernel args are float for every dtype
     dtype diff = ACTIVATION_FINV(y_val,dy_val);
     if(beta == 0)
         dx[pos] = diff;
